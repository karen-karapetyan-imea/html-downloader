.w{display:flex;align-items:center;gap:.5rem}
.v{font-family:SFMono-Regular,Consolas,monospace;font-size:.82rem;color:#111827;word-break:break-all;flex:1;min-width:0}
.b{flex-shrink:0;background:#e5e7eb;border:none;border-radius:6px;padding:.4rem .5rem;cursor:pointer;display:flex;align-items:center;transition:background .15s}
.b:hover{background:#d1d5db}
.b svg{width:16px;height:16px;stroke:#374151}
.b.ok{background:#d1fae5}
.b.ok svg{stroke:#059669}
.h{margin-top:1.5rem;font-size:.85rem;color:#9ca3af;line-height:1.5}
</style>
</head>
<body>
<div class="c">
  <div class="i"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z"/></svg></div>
  <h1>Access Denied</h1>
  <p class="s">Your request has been blocked by our security policies.</p>
  <div class="d">
    <div class="r"><div class="l">Timestamp</div><div class="w"><span class="v" id="t"></span><button type="button" class="b" aria-label="Copy timestamp" onclick="f('t',this)"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v2m-6 12h8a2 2 0 0 0 2-2v-8a2 2 0 0 0-2-2h-8a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2Z"/></svg></button></div></div>
  </div>
  <p class="h">If you believe this is an error, contact support and include the timestamp above.</p>
</div>
<script>
document.getElementById('t').textContent=new Date().toLocaleString('sv-SE',{timeZoneName:'short'});
function f(i,b){if(!navigator.clipboard){return}navigator.clipboard.writeText(document.getElementById(i).textContent).then(function(){b.classList.add('ok');setTimeout(function(){b.classList.remove('ok')},1500)}).catch(function(){})}
</script>
</body>
</html>
