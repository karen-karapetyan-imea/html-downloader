<title>Access Denied</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:#f8f9fa;display:flex;align-items:center;justify-content:center;min-height:100vh;padding:1rem}
.c{background:#fff;border-radius:12px;box-shadow:0 4px 24px rgba(0,0,0,.08);max-width:520px;width:100%;padding:2.5rem;text-align:center}
.i{width:64px;height:64px;margin:0 auto 1.5rem;background:#fee2e2;border-radius:50%;display:flex;align-items:center;justify-content:center}
.i svg{width:32px;height:32px;stroke:#dc2626}
h1{font-size:1.5rem;color:#1f2937;margin-bottom:.5rem}
.s{color:#6b7280;font-size:.95rem;margin-bottom:2rem;line-height:1.5}
