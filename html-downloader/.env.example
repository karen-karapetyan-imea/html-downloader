# Marketplace download provider. curl_cffi is the default and still needs a proxy file.
# decodo uses the Web Data API and does not use local proxies.
DOWNLOAD_PROVIDER=curl_cffi

# Copy the key from the Decodo dashboard. Do not commit a real key.
DECODO_API_KEY=9d3e36787a310dd365aa1167d37d424cf7f368ac992bf4e6cbce73cfc7ae9632

# Synchronous /scrape keeps the connection open. Values above 150 are capped.
DECODO_TIMEOUT_SECONDS=60
DECODO_CONNECT_TIMEOUT_SECONDS=10

# Do not inherit the curl_cffi defaults (16 workers, 8 requests/second).
DECODO_MAX_IN_FLIGHT=4
DECODO_REQUESTS_PER_SECOND=1
DECODO_MAX_RETRIES=1

# Leave unset for the initial HTML response. Set to html to enable JavaScript rendering.
DECODO_JS_RENDERING=
# premium is the API default. standard is cheaper and has less anti-bot coverage.
DECODO_PROXY_POOL=premium
